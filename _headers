/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.mp3
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

/*.mp4
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
